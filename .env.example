# Copiá este archivo a .env (no se versiona) y completá los valores.

# Base de datos (C-01)
DB_URL=jdbc:postgresql://localhost:5432/turnos
DB_USER=turnos
DB_PASSWORD=
TEST_DB_URL=jdbc:postgresql://localhost:5432/turnos_test

# Autenticación (C-04)
JWT_SECRET=
JWT_EXP_MINUTES=480
ADMIN_EMAIL=odontologo@example.com
ADMIN_PASSWORD=

# Email de recordatorios (C-13)
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=turnos@example.com
MAIL_CONTACTO=turnos@example.com

# Frontend (C-02, C-04)
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080/api
